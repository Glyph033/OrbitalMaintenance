// Orbital Maintenance System - index.js
// Initial setup for space station maintenance

console.log("🚀 Orbital Maintenance System initialized");
console.log("Monitoring life support, power, and structural integrity...");

// Core systems status
const systems = {
  oxygen: { level: 98, status: "nominal" },
  power: { level: 87, status: "nominal" },
  pressure: { level: 1013, status: "nominal" },
  temperature: { level: 22, status: "nominal" }
};

function checkSystemHealth() {
  console.log("\n=== SYSTEM HEALTH CHECK ===");
  Object.keys(systems).forEach(system => {
    console.log(`${system.toUpperCase()}: ${systems[system].status} (${systems[system].level}%)`);
  });
}

checkSystemHealth();
